---
/**
 * 라이트박스 — 페이지에 한 번만 두고, 트리거 쪽에서 이미지 목록을 넘긴다.
 * 데스크톱(lg 이상): 좌(이미지, 좌우 오버레이 버튼) / 우(제목·태그·PDF, 상단에 닫기) 2단 레이아웃.
 * 모바일: 검은 상단 바에 이전/다음/카운터를 두고 닫기는 바 우측 끝, 본문은 세로로 쌓인다.
 *
 * 트리거(버튼/링크 등)에 아래 속성을 달면 클릭 시 열린다.
 *   data-lightbox            (필수) 트리거 표시
 *   data-images='[{"src":"…","srcset":"…","alt":"…"}]'  (필수) 이미지 목록 JSON
 *   data-title="…"           (선택) 상단 제목
 *   data-tags='["…"]'        (선택) 우측 패널 태그 목록 JSON
 *   data-desc="…"            (선택) 우측 패널 짧은 설명문
 *   data-tool="…"            (선택) 도구 이름 — data-tool-url과 함께 "○○ 더 알아보기" 버튼
 *   data-tool-url="https://…" (선택)
 *   data-pdf="/pdf/…"        (선택) 우측 패널 PDF 다운로드 버튼
 *   data-pdf-note="…"        (선택) PDF가 아직 없을 때 안내 문구
 *
 * 여러 장이면 좌우 버튼·←/→ 키로 넘긴다. Esc·배경 클릭으로 닫히고,
 * 닫으면 열었던 트리거로 포커스가 돌아간다.
 */
---

<dialog
  id="lightbox"
  data-pagefind-ignore
  class="fixed inset-0 z-50 m-0 h-full max-h-none w-full max-w-none select-none flex-col bg-black/95 p-0 opacity-0 backdrop-blur-sm transition-opacity duration-300 open:flex open:opacity-100"
  aria-modal="true"
>
  <!-- 모바일 전용 상단 바: 이전·카운터·다음(중앙) / 닫기(우측 끝) -->
  <div class="flex h-12 shrink-0 items-center justify-between px-2 text-white lg:hidden">
    <div class="w-10 shrink-0" aria-hidden="true"></div>
    <div class="flex items-center gap-1">
      <button
        type="button"
        data-lb-prev
        class="grid h-9 w-9 cursor-pointer place-items-center rounded-full transition hover:bg-white/10"
        aria-label="이전 장"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <p data-lb-counter class="min-w-[3.5rem] text-center text-[13px] font-medium text-white/80"></p>
      <button
        type="button"
        data-lb-next
        class="grid h-9 w-9 cursor-pointer place-items-center rounded-full transition hover:bg-white/10"
        aria-label="다음 장"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
    <button
      type="button"
      data-lb-close
      class="grid h-10 w-10 shrink-0 cursor-pointer place-items-center rounded-lg transition hover:bg-white/10"
      aria-label="닫기"
    >
      <svg width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <!-- 본문: 좌(이미지) · 우(메타) -->
  <div class="flex min-h-0 flex-1 flex-col lg:flex-row">
    <div class="relative flex min-h-0 flex-1 items-center justify-center overflow-hidden bg-black">
      <!-- 데스크톱 전용 좌우 오버레이 버튼 -->
      <button
        type="button"
        data-lb-prev
        class="absolute left-4 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20 lg:grid"
        aria-label="이전 장"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <img
        data-lb-img
        src=""
        alt=""
        draggable="false"
        class="max-h-full max-w-full select-none object-contain"
      />

      <button
        type="button"
        data-lb-next
        class="absolute right-4 top-1/2 z-10 hidden h-12 w-12 -translate-y-1/2 cursor-pointer place-items-center rounded-full bg-white/10 text-white transition hover:bg-white/20 lg:grid"
        aria-label="다음 장"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <div
      class="flex w-full shrink-0 flex-col border-t border-line bg-white lg:h-full lg:w-[380px] lg:border-l lg:border-t-0"
    >
      <!-- 데스크톱 전용 상단 바: 흰 배경 고정, 하단 구분선으로 본문과 분리 -->
      <div class="hidden shrink-0 items-center justify-between border-b border-line bg-white px-6 py-3 lg:flex">
        <p data-lb-counter class="text-[13px] font-medium text-muted"></p>
        <button
          type="button"
          data-lb-close
          class="grid h-11 w-11 cursor-pointer place-items-center rounded-lg text-ink transition hover:bg-primary-50"
          aria-label="닫기"
        >
          <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div
        class="flex flex-1 flex-col gap-4 overflow-y-auto bg-[radial-gradient(var(--color-line)_1px,transparent_1px)] bg-[length:18px_18px] p-6"
      >
        <p data-lb-title class="text-[21px] font-bold leading-snug text-ink"></p>

        <div data-lb-tags class="flex flex-wrap gap-1.5"></div>

        <p data-lb-desc class="hidden text-[14px] leading-relaxed text-muted"></p>

        <a
          data-lb-tool
          href="#"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden items-center justify-center gap-1.5 rounded-xl border border-primary-400 bg-primary-50/30 px-5 py-2.5 text-[14px] font-semibold text-primary-700 shadow-sm transition hover:bg-primary-50"
        >
          <span data-lb-tool-label></span> 더 알아보기
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M3 11L11 3M5 3h6v6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>

        <div data-lb-pdf-box class="mt-auto hidden flex-col gap-2 border-t border-line pt-4">
          <a
            data-lb-pdf
            href="#"
            download
            class="hidden items-center justify-center gap-2 rounded-xl bg-primary-600 px-5 py-3 text-[15px] font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-primary-700"
          >
            <svg width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
              <path d="M10 3v9m0 0l-3.5-3.5M10 12l3.5-3.5M4 15.5h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            수업 사례 PDF 내려받기
          </a>
          <p data-lb-pdf-note class="hidden text-[13px] text-muted"></p>
        </div>
      </div>
    </div>
  </div>
</dialog>

<script>
  interface LbImage {
    src: string;
    srcset?: string;
    alt?: string;
  }

  function setupLightbox() {
    const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
    if (!dialog || dialog.dataset.init) return;
    dialog.dataset.init = '1';

    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const titleEl = dialog.querySelector<HTMLElement>('[data-lb-title]')!;
    const tagsEl = dialog.querySelector<HTMLElement>('[data-lb-tags]')!;
    const descEl = dialog.querySelector<HTMLElement>('[data-lb-desc]')!;
    const toolLink = dialog.querySelector<HTMLAnchorElement>('[data-lb-tool]')!;
    const toolLabel = dialog.querySelector<HTMLElement>('[data-lb-tool-label]')!;
    // 모바일 상단 바 / 데스크톱 오버레이·사이드바에 각각 짝이 있는 컨트롤들
    const counters = Array.from(dialog.querySelectorAll<HTMLElement>('[data-lb-counter]'));
    const prevBtns = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-lb-prev]'));
    const nextBtns = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-lb-next]'));
    const closeBtns = Array.from(dialog.querySelectorAll<HTMLButtonElement>('[data-lb-close]'));
    const pdfBox = dialog.querySelector<HTMLElement>('[data-lb-pdf-box]')!;
    const pdfLink = dialog.querySelector<HTMLAnchorElement>('[data-lb-pdf]')!;
    const pdfNote = dialog.querySelector<HTMLElement>('[data-lb-pdf-note]')!;

    let images: LbImage[] = [];
    let idx = 0;
    let opener: HTMLElement | null = null;

    const render = () => {
      const cur = images[idx];
      if (!cur) return;
      img.src = cur.src;
      if (cur.srcset) img.srcset = cur.srcset;
      else img.removeAttribute('srcset');
      img.alt = cur.alt ?? '';
      const many = images.length > 1;
      const counterText = many ? `${idx + 1} / ${images.length}` : '';
      counters.forEach((c) => (c.textContent = counterText));
      prevBtns.forEach((b) => (b.hidden = !many));
      nextBtns.forEach((b) => (b.hidden = !many));
    };

    const move = (step: number) => {
      idx = (idx + step + images.length) % images.length;
      render();
    };

    document.addEventListener('click', (e) => {
      const trigger = (e.target as HTMLElement).closest<HTMLElement>('[data-lightbox]');
      if (!trigger) return;
      e.preventDefault();

      try {
        images = JSON.parse(trigger.dataset.images || '[]');
      } catch {
        images = [];
      }
      if (!images.length) return;

      opener = trigger;
      idx = 0;
      titleEl.textContent = trigger.dataset.title ?? '';

      let tags: string[] = [];
      try {
        tags = JSON.parse(trigger.dataset.tags || '[]');
      } catch {
        tags = [];
      }
      tagsEl.replaceChildren(
        ...tags.map((tag) => {
          const span = document.createElement('span');
          span.className =
            'inline-flex items-center rounded-full bg-primary-50 px-2.5 py-1 text-[12px] font-medium text-primary-700';
          span.textContent = tag;
          return span;
        })
      );

      const desc = trigger.dataset.desc ?? '';
      descEl.textContent = desc;
      descEl.classList.toggle('hidden', !desc);

      const toolUrl = trigger.dataset.toolUrl;
      toolLink.classList.toggle('hidden', !toolUrl);
      toolLink.classList.toggle('inline-flex', !!toolUrl);
      if (toolUrl) {
        toolLink.href = toolUrl;
        toolLabel.textContent = trigger.dataset.tool ?? '';
      }

      const pdf = trigger.dataset.pdf;
      const note = trigger.dataset.pdfNote;
      pdfBox.classList.toggle('hidden', !pdf && !note);
      pdfLink.classList.toggle('hidden', !pdf);
      pdfLink.classList.toggle('inline-flex', !!pdf);
      if (pdf) pdfLink.href = pdf;
      pdfNote.textContent = !pdf && note ? note : '';
      pdfNote.classList.toggle('hidden', !!pdf || !note);

      render();
      dialog.showModal();
    });

    // mousedown에서 기본 동작을 막아, 빠르게 연타할 때 이미지가 드래그 선택되는 것을 방지한다.
    [...prevBtns, ...nextBtns].forEach((b) => b.addEventListener('mousedown', (e) => e.preventDefault()));
    prevBtns.forEach((b) => b.addEventListener('click', () => move(-1)));
    nextBtns.forEach((b) => b.addEventListener('click', () => move(1)));
    closeBtns.forEach((b) => b.addEventListener('click', () => dialog.close()));

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') move(-1);
      if (e.key === 'ArrowRight') move(1);
    });

    // 배경(=dialog 자체) 클릭만 닫기 — 이미지·버튼 클릭은 통과시킨다
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => opener?.focus());
  }

  setupLightbox();
  document.addEventListener('astro:page-load', setupLightbox);
</script>

<style>
  dialog::backdrop {
    background: transparent;
  }
</style>
