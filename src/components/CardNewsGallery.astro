---
/**
 * 카드뉴스 갤러리 — 대분류(초·중·고) 아래 3열 갤러리.
 * 썸네일은 카드뉴스 1면(1688×2110 비율), 누르면 라이트박스에서 장을 넘겨본다.
 *
 * 이미지: src/assets/cards/{section}/{id}/01.png …  (목록·제목은 src/data/classCards.ts)
 * PDF(case 전용): 같은 폴더 안에 아무 이름의 .pdf 파일 하나를 두면 자동으로 인식된다.
 * 원본 이미지를 그대로 두면 빌드 시 getImage()가 webp로 재생성하므로 용량이 큰 원본도 그대로 커밋해도 된다.
 */
import { getImage } from 'astro:assets';
import Lightbox from './Lightbox.astro';
import {
  classCards,
  levelLabels,
  levelOrder,
  subjectFamilyOf,
  subjectFamilyOrder,
  type CardNewsItem,
  type Level,
  type Section,
} from '../data/classCards';
import { toolLinks } from '../data/toolLinks';

interface Props {
  section: Section;
  /** case 섹션처럼 라이트박스 하단에 PDF 버튼을 둘지 */
  showPdf?: boolean;
  /** 대분류 기준 — level(기본, 초·중·고) 또는 subject(edtech 전용, 수학·영어·정보) */
  groupBy?: 'level' | 'subject';
}
const { section, showPdf = false, groupBy = 'level' } = Astro.props;

const all = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/cards/**/*.{png,jpg,jpeg,webp}',
  { eager: true }
);

const pdfUrls = import.meta.glob<string>('/src/assets/cards/**/*.pdf', {
  eager: true,
  query: '?url',
  import: 'default',
});

// 카드뉴스 원본 비율(1688×2110)
const CARD_RATIO = 1688 / 2110;
const THUMB_W = 480;
const FULL_W = [800, 1400];

const items = await Promise.all(
  classCards[section].map(async (item) => {
    const sources = Object.entries(all)
      .filter(([p]) => p.includes(`/cards/${section}/${item.id}/`))
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([, m]) => m.default);

    const thumb = sources[0]
      ? await getImage({
          src: sources[0],
          width: Math.min(THUMB_W, sources[0].width),
          format: 'webp',
          quality: 80,
        })
      : null;

    const images = await Promise.all(
      sources.map(async (src, i) => {
        const widths = [...new Set(FULL_W.map((w) => Math.min(w, src.width)))].sort((a, b) => a - b);
        const variants = await Promise.all(
          widths.map((width) => getImage({ src, width, format: 'webp', quality: 85 }))
        );
        return {
          src: variants[variants.length - 1].src,
          srcset: variants.map((v, n) => `${v.src} ${widths[n]}w`).join(', '),
          alt: `${item.title} ${i + 1}면`,
        };
      })
    );

    const tags = [item.publisher, item.subject, item.gradeTerm, item.tool].filter(
      (v): v is string => Boolean(v)
    );

    // PDF는 같은 폴더 안에 파일이 실제로 있을 때만 제공 — 없으면 "탑재 예정"으로 표시
    const pdfUrl = Object.entries(pdfUrls).find(([p]) =>
      p.includes(`/cards/${section}/${item.id}/`)
    )?.[1];
    const pdfReady = showPdf && Boolean(pdfUrl);

    const toolUrl = item.tool ? toolLinks[item.tool] : undefined;

    return { ...item, thumb, images, tags, pdfUrl, pdfReady, toolUrl };
  })
);

const levelIndex = (level: Level) => levelOrder.indexOf(level);

// 그룹 안 정렬 키 — 'levelIndex'는 학교급 표시 순서(초→중→고)로 비교
type SortKey = keyof CardNewsItem | 'levelIndex';
const compareBy = (a: CardNewsItem, b: CardNewsItem, keys: SortKey[]) => {
  for (const k of keys) {
    const av = k === 'levelIndex' ? String(levelIndex(a.level)) : String(a[k] ?? '');
    const bv = k === 'levelIndex' ? String(levelIndex(b.level)) : String(b[k] ?? '');
    const cmp = av.localeCompare(bv, 'ko');
    if (cmp !== 0) return cmp;
  }
  return 0;
};

const groups =
  groupBy === 'subject'
    ? subjectFamilyOrder.map((family) => ({
        key: family as string,
        label: family as string,
        list: items
          .filter((i) => subjectFamilyOf(i.subject) === family)
          .sort((a, b) => compareBy(a, b, ['levelIndex', 'tool'])),
      }))
    : levelOrder.map((level) => ({
        key: level as string,
        label: levelLabels[level],
        list: items
          .filter((i) => i.level === level)
          .sort((a, b) =>
            section === 'case' ? compareBy(a, b, ['subject', 'gradeTerm']) : 0
          ),
      }));

const hasAny = items.length > 0;
---

<div class="mt-10 space-y-12">
  {
    groups.map(({ key, label, list }) => {
      return (
        <section>
          <h2 class="section-mark text-[20px] font-bold tracking-tight text-ink">
            {label}
          </h2>

          <ul class="mt-5 grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3">
            {list.length > 0
              ? list.map((item) => (
                  <li>
                    <button
                      type="button"
                      data-lightbox
                      data-images={JSON.stringify(item.images)}
                      data-title={item.title}
                      data-tags={JSON.stringify(item.tags)}
                      data-desc={item.desc}
                      data-tool={item.tool}
                      data-tool-url={item.toolUrl}
                      data-pdf={item.pdfReady ? item.pdfUrl : undefined}
                      data-pdf-note={showPdf ? '탑재 예정입니다.' : undefined}
                      class="group w-full cursor-zoom-in overflow-hidden rounded-[var(--radius-card)] border border-line bg-white text-left shadow-[var(--shadow-card)] transition-all hover:-translate-y-0.5 hover:border-primary-400 hover:shadow-[var(--shadow-card-hover)]"
                    >
                      {item.thumb ? (
                        <img
                          src={item.thumb.src}
                          alt={`${item.title} 카드뉴스 1면`}
                          loading="lazy"
                          class="w-full object-cover"
                          style={`aspect-ratio: ${CARD_RATIO}`}
                        />
                      ) : (
                        <span
                          class="grid w-full place-content-center gap-1.5 border-b border-dashed border-line bg-primary-50/40 text-center text-[13px] text-muted"
                          style={`aspect-ratio: ${CARD_RATIO}`}
                        >
                          <span class="mx-auto inline-flex items-center rounded-full bg-accent/10 px-2.5 py-1 text-[11px] font-bold text-accent">
                            탑재 예정
                          </span>
                        </span>
                      )}
                      <span class="block px-4 py-3.5">
                        <h3
                          id={item.id}
                          class="block text-[15px] font-semibold leading-snug text-ink group-hover:text-primary-700"
                        >
                          {item.title}
                        </h3>
                        {item.desc && <span class="sr-only">{item.desc}</span>}
                        {item.tags.length > 0 && (
                          <span class="mt-2 flex flex-wrap gap-1.5">
                            {item.tags.map((tag) => (
                              <span class="inline-flex items-center rounded-full bg-primary-50 px-2 py-0.5 text-[11px] font-medium text-primary-700">
                                {tag}
                              </span>
                            ))}
                          </span>
                        )}
                        {showPdf && !item.pdfReady && (
                          <span class="mt-1 block text-[13px] text-muted">탑재 예정</span>
                        )}
                      </span>
                    </button>
                  </li>
                ))
              : [0, 1, 2].map(() => (
                  <li>
                    <div class="overflow-hidden rounded-[var(--radius-card)] border-2 border-dashed border-line bg-white/50">
                      <span
                        class="grid w-full place-content-center px-3 text-center text-[13px] text-muted"
                        style={`aspect-ratio: ${CARD_RATIO}`}
                      >
                        카드뉴스 자리
                      </span>
                      <span class="block border-t border-dashed border-line px-4 py-3.5 text-[13px] text-muted">
                        준비 중입니다
                      </span>
                    </div>
                  </li>
                ))}
          </ul>
        </section>
      );
    })
  }
</div>

{
  !hasAny && (
    <p class="mt-10 rounded-[var(--radius-card)] border border-line bg-white p-5 text-center text-[14px] text-muted">
      자료가 준비되는 대로 학교급별 카드뉴스가 이 자리에 올라옵니다.
    </p>
  )
}

<Lightbox />
