---
/**
 * 캐러셀 — CSS scroll-snap 기반. 모바일 스와이프 자연 지원, JS는 점 표시/이동만(경량).
 * MDX: <Carousel images={[{ src, alt }, ...]} />
 *
 * autoplay: 자동 넘김(기본 off). 마우스 오버·포커스·탭 비활성 시 정지하고,
 *           prefers-reduced-motion: reduce 이면 아예 동작하지 않는다.
 * ratio:    슬라이드 고정 비율(예: '16/9', '1/1'). 지정하지 않으면 이미지 원본 비율.
 */
interface Slide {
  src: string;
  alt?: string;
  caption?: string;
}
interface Props {
  images: Slide[];
  autoplay?: boolean;
  interval?: number;
  ratio?: string;
}
const { images, autoplay = false, interval = 5000, ratio } = Astro.props;
const uid = 'car-' + Math.random().toString(36).slice(2, 8);
---

<div
  class="carousel not-prose relative group/carousel"
  data-carousel
  data-uid={uid}
  data-autoplay={autoplay ? String(interval) : undefined}
>
  {
    images.length > 1 && (
      <>
        <button
          type="button"
          class="absolute left-4 top-1/2 -translate-y-1/2 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/90 text-ink shadow-sm transition-all hover:bg-white hover:scale-105 active:scale-95 opacity-0 group-hover/carousel:opacity-100 focus:opacity-100 cursor-pointer"
          data-prev-btn
          aria-label="이전 슬라이드"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" />
          </svg>
        </button>
        <button
          type="button"
          class="absolute right-4 top-1/2 -translate-y-1/2 z-10 flex h-10 w-10 items-center justify-center rounded-full border border-line bg-white/90 text-ink shadow-sm transition-all hover:bg-white hover:scale-105 active:scale-95 opacity-0 group-hover/carousel:opacity-100 focus:opacity-100 cursor-pointer"
          data-next-btn
          aria-label="다음 슬라이드"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </>
    )
  }

  <div
    class="scroll-track flex snap-x snap-mandatory gap-0 overflow-x-auto scroll-smooth rounded-2xl [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]"
    role="group"
    aria-roledescription="캐러셀"
    tabindex="0"
  >
    {
      images.map((img, i) => (
        <figure class="relative w-full shrink-0 snap-center" data-slide>
          <img
            src={img.src}
            alt={img.alt ?? `슬라이드 ${i + 1}`}
            loading={i === 0 ? 'eager' : 'lazy'}
            style={ratio ? `aspect-ratio:${ratio}` : undefined}
            class:list={[
              'w-full rounded-2xl border border-line',
              ratio ? 'h-full object-cover' : 'h-auto object-contain',
            ]}
          />
          {img.caption && (
            <figcaption class="absolute inset-x-0 bottom-0 rounded-b-2xl bg-gradient-to-t from-ink/70 to-transparent px-4 py-3 text-sm text-white">
              {img.caption}
            </figcaption>
          )}
        </figure>
      ))
    }
  </div>

  {
    images.length > 1 && (
      <div class="mt-3 flex items-center justify-center gap-2" data-dots>
        {images.map((_, i) => (
          <button
            type="button"
            class="h-2 w-2 rounded-full bg-line transition-all data-[active]:w-5 data-[active]:bg-primary-500"
            data-dot
            data-index={i}
            aria-label={`${i + 1}번 슬라이드로 이동`}
          />
        ))}
      </div>
    )
  }
</div>

<script>
  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      if (root.dataset.init) return;
      root.dataset.init = '1';
      const track = root.querySelector<HTMLElement>('.scroll-track')!;
      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
      const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
      if (!slides.length) return;

      let currentIdx = 0;

      // 현재 위치는 스크롤 좌표에서 직접 계산한다.
      // (IntersectionObserver는 점 표시 갱신용 — 콜백이 늦으면 이동 목표가 어긋난다)
      const indexFromScroll = () =>
        Math.min(slides.length - 1, Math.round(track.scrollLeft / track.clientWidth));

      const goTo = (idx: number) => {
        slides[idx]?.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      };

      const setActive = (idx: number) => {
        currentIdx = idx;
        dots.forEach((d, i) =>
          i === idx ? d.setAttribute('data-active', '') : d.removeAttribute('data-active')
        );
      };
      setActive(0);

      dots.forEach((dot) =>
        dot.addEventListener('click', () => goTo(Number(dot.dataset.index)))
      );

      // 좌우 버튼 바인딩
      const prevBtn = root.querySelector<HTMLButtonElement>('[data-prev-btn]');
      const nextBtn = root.querySelector<HTMLButtonElement>('[data-next-btn]');

      prevBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        goTo((indexFromScroll() - 1 + slides.length) % slides.length);
      });

      nextBtn?.addEventListener('click', (e) => {
        e.preventDefault();
        goTo((indexFromScroll() + 1) % slides.length);
      });

      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) setActive(slides.indexOf(e.target as HTMLElement));
          });
        },
        { root: track, threshold: 0.6 }
      );
      slides.forEach((s) => io.observe(s));

      // 자동 넘김 — data-autoplay="{ms}" 가 있을 때만. 접근성상 감속 선호 시 미동작.
      const delay = Number(root.dataset.autoplay);
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!delay || slides.length < 2 || reduceMotion) return;

      let timer: ReturnType<typeof setInterval> | null = null;
      const stop = () => {
        if (timer) clearInterval(timer);
        timer = null;
      };
      const start = () => {
        if (timer) return;
        timer = setInterval(() => goTo((indexFromScroll() + 1) % slides.length), delay);
      };

      // 조작 중(오버·포커스·터치)에는 멈추고, 벗어나면 재개
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      root.addEventListener('touchstart', stop, { passive: true });
      document.addEventListener('visibilitychange', () =>
        document.hidden ? stop() : start()
      );
      start();
    });
  }
  initCarousels();
  document.addEventListener('astro:page-load', initCarousels);
</script>
