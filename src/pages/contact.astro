    members: [
      { name: '미래엔', url: 'https://aidt.m-teacher.co.kr/', tel: '02-3475-4021' },
      {
        name: '금성출판사',
        url: 'https://cs.kumsung.co.kr/member/customer/callCenter.do',
        tel: '02-2077-8233',
      },
      { name: '지학사', url: 'https://textbook.jihak.co.kr/AIDT22/index.html', tel: '1566-1053' },
      { name: '교학사', url: 'https://aidt.kyohak.co.kr/', tel: '1566-1053' },
      { name: '디딤돌교육', tel: '1566-1053' },
      { name: '비상교육', tel: '1544-0554' },
      { name: '천재교육', tel: '1522-1955' },
      { name: '천재교과서', tel: '1522-1955' },
      { name: '엔이능률', tel: '1833-8368' },
    ],
    groups: [
