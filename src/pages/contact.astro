---
/**
 * 문의 및 장애 지원 — 원본(docs/original/CONTENT.md §14) 텍스트 그대로.
 * 하단 두 카드(공동CS센터·발행사 지원센터)는 안내 이미지 대신 구조화된 텍스트로 제공한다.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

// 발행사 문의 창구 — 같은 모양 카드 2장(공동CS 참여사 / 미참여사)
interface Item {
  text: string;
  subs?: string[];
}
/** url·tel이 있으면 칩 대신 아코디언으로 펼쳐 보여준다 */
interface Member {
  name: string;
  url?: string;
  tel?: string;
}
interface Desk {
  title: string;
  tel?: string;
  memberLabel: string;
  members: Member[];
  groups: { heading: string; items: Item[] }[];
}

