---

<BaseLayout
  title="문의 및 장애 지원"
  description="AI·디지털 교육자료 관련 문의 및 장애 지원 안내 — 중앙상담센터, 테크센터, 교육디지털원패스"
>
  <section class="mx-auto max-w-3xl px-5 py-12 sm:py-14">
    <h1 class="title-underline text-center text-[24px] font-bold leading-tight text-ink sm:text-[30px]">
      AI·디지털 교육자료 관련 문의 및 장애 지원
    </h1>

    <div class="mt-10 space-y-5">
      <!-- 교육부 중앙상담센터 -->
      <article class="rounded-[var(--radius-card)] border border-line bg-white p-6 shadow-[var(--shadow-card)]">
        <h2 class="text-[18px] font-bold text-ink">
          [교육부] AI·디지털 교육자료 중앙상담센터
          <span class="text-primary-600">(☎ 1600-2525)</span>
        </h2>
        <dl class="mt-4 space-y-3 text-[15px] leading-relaxed">
          <div>
            <dt class="font-semibold text-ink">지원 내용</dt>
            <dd class="text-muted">AI 디지털교과서 플랫폼 문의 및 장애 지원</dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">접수 / 처리</dt>
            <dd class="text-muted">
              ARS(1600-2525) ·
              <a href="https://www.aidtbook.kr" target="_blank" rel="noopener noreferrer" class="text-primary-600 underline underline-offset-2">온라인(www.aidtbook.kr)</a>
            </dd>
          </div>
        </dl>
      </article>

      <!-- 우리교육청 테크센터 -->
      <article class="rounded-[var(--radius-card)] border border-line bg-white p-6 shadow-[var(--shadow-card)]">
        <h2 class="text-[18px] font-bold text-ink">[우리교육청] 테크센터 운영</h2>
        <dl class="mt-4 space-y-3 text-[15px] leading-relaxed">
          <div>
            <dt class="font-semibold text-ink">지원 내용</dt>
            <dd class="text-muted">
              학교 디지털인프라 관련 사항 상담 신청<br />
              <span class="text-[13px]">* 학교망(스쿨넷, 무선망), 무선통신장비, 무선 접속, 스마트기기 관련</span>
            </dd>
          </div>
          <div>
            <dt class="font-semibold text-ink">접수 / 처리</dt>
            <dd class="text-muted">
              통합콜센터 (☎ 053-235-9999) 근무시간 : 09:00 ~ 18:00(공휴일, 점심시간 제외)<br />
              <a href="https://tech.dge.go.kr" target="_blank" rel="noopener noreferrer" class="text-primary-600 underline underline-offset-2">테크센터포털(tech.dge.go.kr)</a>
              : 운영 관련 시스템(무선인증, MDM) 연결 지원
            </dd>
          </div>
        </dl>
      </article>

      <!-- 교육디지털원패스 -->
      <article class="rounded-[var(--radius-card)] border border-line bg-white p-6 shadow-[var(--shadow-card)]">
        <h2 class="text-[18px] font-bold text-ink">
          교육디지털원패스
          <span class="text-primary-600">콜센터 (☎ 1600-7440)</span>
        </h2>
      </article>

      <!-- 발행사 문의 창구 — 공동CS 참여사 / 미참여사 -->
      {
        desks.map((desk) => (
          <article class="rounded-[var(--radius-card)] border border-line bg-white p-6 shadow-[var(--shadow-card)]">
            <h2 class="text-[18px] font-bold text-ink">
              {desk.title}
              {desk.tel && <span class="text-primary-600"> (☎ {desk.tel})</span>}
            </h2>

            <div class="mt-4">
              <p class="text-[14px] font-semibold text-ink">{desk.memberLabel}</p>

              {/* 개별 창구가 있는 발행사는 칩을 누르면 바로 아래 패널에 링크·연락처가 열린다 */}
              <div data-chip-group>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {desk.members.map((m) =>
                    m.url || m.tel ? (
                      <li>
                        <button
                          type="button"
                          data-chip
                          data-name={m.name}
                          data-url={m.url}
                          data-tel={m.tel}
                          aria-expanded="false"
                          class="cursor-pointer rounded-full border border-line bg-primary-50/60 px-2.5 py-1 text-[13px] text-ink transition-colors hover:border-primary-400 hover:text-primary-700 aria-expanded:border-primary-600 aria-expanded:bg-primary-600 aria-expanded:text-white"
                        >
                          {m.name}
                        </button>
                      </li>
                    ) : (
                      <li class="rounded-full border border-line bg-primary-50/60 px-2.5 py-1 text-[13px] text-ink">
                        {m.name}
                      </li>
                    )
                  )}
                </ul>

                <div
                  data-chip-panel
                  hidden
                  class="mt-2.5 rounded-xl border border-primary-200 bg-primary-50/50 px-4 py-3 text-[14px] leading-relaxed"
                >
                </div>
              </div>
            </div>

            <dl class="mt-5 space-y-4 text-[15px] leading-relaxed">
              {desk.groups.map((g) => (
                <div>
                  <dt class="font-semibold text-ink">{g.heading}</dt>
                  <dd class="mt-1.5">
                    <ul class="space-y-1.5 text-muted">
                      {g.items.map((item) => (
                        <li class="pl-4 -indent-4">
                          <span class="mr-1.5 text-primary-500">•</span>
                          {item.text}
                          {item.subs && (
                            <ul class="mt-1 space-y-1 pl-4 indent-0 text-[14px]">
                              {item.subs.map((s) => (
                                <li class="pl-3 -indent-3">
                                  <span class="mr-1.5 text-line">–</span>
                                  {s}
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
              ))}
            </dl>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  /** 발행사 칩 → 바로 아래 패널에 링크·연락처 표시(같은 칩을 다시 누르면 닫힘) */
  function setupChips() {
    document.querySelectorAll<HTMLElement>('[data-chip-group]').forEach((group) => {
      if (group.dataset.init) return;
      group.dataset.init = '1';

      const panel = group.querySelector<HTMLElement>('[data-chip-panel]')!;
      const chips = Array.from(group.querySelectorAll<HTMLButtonElement>('[data-chip]'));

      const close = () => {
        chips.forEach((c) => c.setAttribute('aria-expanded', 'false'));
        panel.hidden = true;
        panel.innerHTML = '';
      };

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          if (chip.getAttribute('aria-expanded') === 'true') {
            close();
            return;
          }
          close();
          chip.setAttribute('aria-expanded', 'true');

          const { name, url, tel } = chip.dataset;
          const rows: string[] = [`<span class="font-bold text-ink">${name}</span>`];
          if (url) {
            rows.push(
              `<a href="${url}" target="_blank" rel="noopener noreferrer" class="text-primary-600 underline underline-offset-2 break-all">${url}</a>`
            );
          }
          rows.push(
            tel
              ? `<span class="text-ink">문의 전화 <a href="tel:${tel}" class="font-bold text-primary-600 underline underline-offset-2">${tel}</a></span>`
              : `<span class="text-muted">콜센터 미운영 — 위 링크의 온라인 문의를 이용해 주세요.</span>`
          );

          panel.innerHTML = `<div class="flex flex-col gap-1">${rows.join('')}</div>`;
          panel.hidden = false;
        });
      });
    });
  }

  setupChips();
  document.addEventListener('astro:page-load', setupChips);
</script>
