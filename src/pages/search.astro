---
import BaseLayout from '../layouts/BaseLayout.astro';
import { nav } from '../data/nav';

// 검색 결과가 없거나 아직 입력 전일 때 보여줄 바로가기 — 메뉴 데이터에서 뽑는다.
const shortcuts = [
  ...(nav.find((n) => n.href === '/index')?.children ?? []),
  ...(nav.find((n) => n.href === '/class')?.children ?? []),
].filter((c) => !c.external);
---

<BaseLayout title="검색" description="사이트 내 문서 및 자료 통합 검색">
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:py-16">
    <div class="mb-8">
      <h1 class="text-2xl font-bold tracking-tight text-ink sm:text-3xl">사이트 내 검색</h1>
    </div>

    <!-- Pagefind가 검색 인터페이스를 렌더링할 타겟 컨테이너 -->
    <div id="search" class="min-h-[300px]"></div>

    <!-- 검색이 막혔을 때의 탈출구 -->
    <nav aria-label="주요 페이지 바로가기" class="mt-12 border-t border-line pt-8" data-pagefind-ignore>
      <p class="text-[15px] font-bold text-ink">찾는 내용이 없다면</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          shortcuts.map((s) => (
            <li>
              <a
                href={s.href}
                class="inline-block rounded-full border border-line bg-white px-3.5 py-1.5 text-[14px] text-ink transition-colors hover:border-primary-400 hover:text-primary-700"
              >
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</BaseLayout>

<!-- Pagefind UI 번들 리소스 로드 -->
<link rel="stylesheet" href="/pagefind/pagefind-ui.css" />
<script is:inline src="/pagefind/pagefind-ui.js"></script>

<script is:inline>
  window.addEventListener('DOMContentLoaded', () => {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#search',
        showSubResults: true,
        // 자리표시자 이름은 Pagefind 규격을 따른다([SEARCH_TERM]/[COUNT]/[DIFFERENT_TERM]).
        // 소문자 [search]·[count]로 쓰면 치환되지 않고 그대로 노출된다.
        translations: {
          placeholder: "검색어를 입력해 주세요 (예: NEIS, 교육디지털원패스, 금성)",
          clear_search: "지우기",
          load_more: "결과 더 보기",
          search_label: "검색",
          filters_label: "필터",
          zero_results: "'[SEARCH_TERM]'에 대한 검색 결과가 없습니다.",
          many_results: "'[SEARCH_TERM]'에 대한 검색 결과 [COUNT]개",
          one_result: "'[SEARCH_TERM]'에 대한 검색 결과 [COUNT]개",
          alt_search: "'[SEARCH_TERM]'에 대한 결과가 없어 '[DIFFERENT_TERM]' 결과를 보여드립니다.",
          searching: "'[SEARCH_TERM]' 검색 중…"
        }
      });
    } else {
      document.getElementById('search').innerHTML = 
        `<div class="rounded-lg border border-yellow-200 bg-yellow-50 p-5 text-sm text-yellow-800 leading-relaxed shadow-sm">
          <p class="font-semibold mb-1">💡 안내 사항</p>
          로컬 개발 서버(dev)에서는 정적 검색 인덱스가 활성화되지 않습니다.<br />
          실제 작동은 <strong>npm run build</strong> 실행 후 <strong>npm run preview</strong> 또는 배포된 서버에서 확인하실 수 있습니다.
        </div>`;
    }
  });
</script>

<style is:global>
  /*
    Pagefind UI를 현재 디자인 토큰(딥 네이비 + 웜 오렌지)에 맞춘다.
    pagefind-ui.css가 이 페이지 스타일보다 나중에 로드되며 같은 :root 변수를 정의하므로,
    :root에 선언하면 덮어써진다 → 컨테이너(#search)에 선언해 내부로 상속시킨다.
  */
  #search {
    --pagefind-ui-primary: var(--color-primary-600);
    --pagefind-ui-text: var(--color-ink);
    --pagefind-ui-background: var(--color-surface);
    --pagefind-ui-border: var(--color-line);
    --pagefind-ui-tag: var(--color-band);
  }
  
  #search .pagefind-ui__search-input {
    font-size: 1rem;
    font-weight: 500;
    border-radius: 0.5rem;
    border: 1px solid var(--pagefind-ui-border);
    transition: all 0.2s ease;
  }

  #search .pagefind-ui__search-input:focus {
    outline: none;
    border-color: var(--pagefind-ui-primary);
    box-shadow: 0 0 0 3px rgba(27, 68, 112, 0.15);
  }

  #search .pagefind-ui__search-clear {
    border-radius: 0.375rem;
    background-color: var(--pagefind-ui-tag);
    color: var(--pagefind-ui-text);
  }

  #search .pagefind-ui__result {
    border-top: 1px solid var(--pagefind-ui-border);
    padding: 1.5rem 0;
  }

  #search .pagefind-ui__result-title a {
    color: var(--pagefind-ui-primary);
    font-weight: 700;
    text-decoration: none;
  }

  #search .pagefind-ui__result-title a:hover {
    text-decoration: underline;
  }

  #search .pagefind-ui__result-excerpt {
    color: var(--color-muted);
    font-size: 0.925rem;
    margin-top: 0.5rem;
    line-height: 1.6;
  }

  #search .pagefind-ui__result-excerpt mark {
    background-color: var(--color-accent-soft);
    color: var(--color-accent); /* 웜 오렌지 강조 */
    font-weight: 600;
    padding: 0 0.125rem;
    border-radius: 0.125rem;
  }
</style>
